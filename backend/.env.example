# Render sets PORT automatically; `npm run dev` always uses 3000
PORT=3000

# Where the model service lives
MODEL_SERVICE_URL=http://localhost:5001

# Allowed browser origins, comma-separated, or * for any
# Production: https://three-3xo-1.onrender.com
CORS_ORIGIN=*

# Render free instances sleep; waking the model service can take ~50s
MODEL_TIMEOUT_MS=60000
